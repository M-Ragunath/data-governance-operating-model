                    <mxGeometry height="42" width="542" x="748" y="885" as="geometry"/>
                </mxCell>
                <mxCell id="cap-body-06" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=17;fontColor=#0F766E;shadow=1;textShadow=1;" value="&lt;b&gt;Purpose:&lt;/b&gt; Connect written policy to implemented, tested controls.&lt;br&gt;&lt;br&gt;&lt;b&gt;Applies to:&lt;/b&gt; Plan &amp;amp; Govern; Manage &amp;amp; Protect; Measure &amp;amp; Improve.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lead / decisions:&lt;/b&gt; Named policy/control owner; custodians implement and stewards coordinate evidence.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; Policy-control matrix; enforcement configuration; test results; protected evidence; exception and remediation records." vertex="1">
                    <mxGeometry height="240" width="605" x="685" y="936" as="geometry"/>
                </mxCell>
                <mxCell id="cap-card-07" parent="1" style="rounded=1;arcSize=5;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.5;shadow=1;textShadow=1;shadow=1;gradientColor=#FFFFFF;gradientDirection=north;" value="" vertex="1">
                    <mxGeometry height="320" width="635" x="15" y="1215" as="geometry"/>
                </mxCell>
                <mxCell id="cap-badge-07" parent="1" style="rounded=1;arcSize=20;fillColor=#6D28D9;strokeColor=none;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#FFFFFF;shadow=1;textShadow=1;" value="C07" vertex="1">
                    <mxGeometry height="34" width="55" x="27" y="1227" as="geometry"/>
                </mxCell>
                <mxCell id="cap-heading-07" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=23;fontStyle=1;fontColor=#6D28D9;shadow=1;textShadow=1;" value="External data sharing" vertex="1">
                    <mxGeometry height="42" width="542" x="93" y="1225" as="geometry"/>
                </mxCell>
                <mxCell id="cap-body-07" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=17;fontColor=#6D28D9;shadow=1;textShadow=1;" value="&lt;b&gt;Purpose:&lt;/b&gt; Control data use beyond the immediate organizational boundary.&lt;br&gt;&lt;br&gt;&lt;b&gt;Applies to:&lt;/b&gt; Plan &amp;amp; Govern; Manage &amp;amp; Protect; Share &amp;amp; Use.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lead / decisions:&lt;/b&gt; Asset owner for business permission, with legal, privacy, security and procurement support.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; Sharing register; due diligence; agreement; transfer controls; periodic review; termination and disposition evidence." vertex="1">
                    <mxGeometry height="240" width="605" x="30" y="1276" as="geometry"/>
                </mxCell>
                <mxCell id="cap-card-08" parent="1" style="rounded=1;arcSize=5;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.5;shadow=1;textShadow=1;shadow=1;gradientColor=#FFFFFF;gradientDirection=north;" value="" vertex="1">
                    <mxGeometry height="320" width="635" x="670" y="1215" as="geometry"/>
                </mxCell>
                <mxCell id="cap-badge-08" parent="1" style="rounded=1;arcSize=20;fillColor=#6D28D9;strokeColor=none;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#FFFFFF;shadow=1;textShadow=1;" value="C08" vertex="1">
                    <mxGeometry height="34" width="55" x="682" y="1227" as="geometry"/>
                </mxCell>
                <mxCell id="cap-heading-08" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=23;fontStyle=1;fontColor=#6D28D9;shadow=1;textShadow=1;" value="AI data governance" vertex="1">
                    <mxGeometry height="42" width="542" x="748" y="1225" as="geometry"/>
                </mxCell>
                <mxCell id="cap-body-08" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=17;fontColor=#6D28D9;shadow=1;textShadow=1;" value="&lt;b&gt;Purpose:&lt;/b&gt; Ensure data is suitable and permitted for its specific AI use.&lt;br&gt;&lt;br&gt;&lt;b&gt;Applies to:&lt;/b&gt; All five stages.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lead / decisions:&lt;/b&gt; Data owner for data permission and fitness, jointly coordinated with a named AI use-case owner.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; AI data-use register; provenance and permission records; dataset versions; fitness review; deletion-impact assessment." vertex="1">
                    <mxGeometry height="240" width="605" x="685" y="1276" as="geometry"/>
                </mxCell>
                <mxCell id="cap-card-09" parent="1" style="rounded=1;arcSize=5;fillColor=#FDF2F8;strokeColor=#F472B6;strokeWidth=1.5;shadow=1;textShadow=1;shadow=1;gradientColor=#FFFFFF;gradientDirection=north;" value="" vertex="1">
                    <mxGeometry height="320" width="635" x="15" y="1555" as="geometry"/>
                </mxCell>
                <mxCell id="cap-badge-09" parent="1" style="rounded=1;arcSize=20;fillColor=#BE185D;strokeColor=none;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#FFFFFF;shadow=1;textShadow=1;" value="C09" vertex="1">
                    <mxGeometry height="34" width="55" x="27" y="1567" as="geometry"/>
                </mxCell>
                <mxCell id="cap-heading-09" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=23;fontStyle=1;fontColor=#BE185D;shadow=1;textShadow=1;" value="Funding and capacity" vertex="1">
                    <mxGeometry height="42" width="542" x="93" y="1565" as="geometry"/>
                </mxCell>
                <mxCell id="cap-body-09" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=17;fontColor=#BE185D;shadow=1;textShadow=1;" value="&lt;b&gt;Purpose:&lt;/b&gt; Give governance responsibilities realistic operating resources.&lt;br&gt;&lt;br&gt;&lt;b&gt;Applies to:&lt;/b&gt; Plan &amp;amp; Govern; Measure &amp;amp; Improve.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lead / decisions:&lt;/b&gt; Executive sponsor and council for funding decisions; domain owners for domain capacity.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; Funded roadmap; capacity plan; service cost allocation; prioritized backlog; benefits and workload review." vertex="1">
                    <mxGeometry height="240" width="605" x="30" y="1616" as="geometry"/>
                </mxCell>
                <mxCell id="cap-card-10" parent="1" style="rounded=1;arcSize=5;fillColor=#FDF2F8;strokeColor=#F472B6;strokeWidth=1.5;shadow=1;textShadow=1;shadow=1;gradientColor=#FFFFFF;gradientDirection=north;" value="" vertex="1">
                    <mxGeometry height="320" width="635" x="670" y="1555" as="geometry"/>
                </mxCell>
                <mxCell id="cap-badge-10" parent="1" style="rounded=1;arcSize=20;fillColor=#BE185D;strokeColor=none;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#FFFFFF;shadow=1;textShadow=1;" value="C10" vertex="1">
                    <mxGeometry height="34" width="55" x="682" y="1567" as="geometry"/>
                </mxCell>
                <mxCell id="cap-heading-10" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=23;fontStyle=1;fontColor=#BE185D;shadow=1;textShadow=1;" value="Maturity assessment" vertex="1">
                    <mxGeometry height="42" width="542" x="748" y="1565" as="geometry"/>
                </mxCell>
                <mxCell id="cap-body-10" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=17;fontColor=#BE185D;shadow=1;textShadow=1;" value="&lt;b&gt;Purpose:&lt;/b&gt; Use evidence to select the next practical improvement.&lt;br&gt;&lt;br&gt;&lt;b&gt;Applies to:&lt;/b&gt; Measure &amp;amp; Improve; Plan &amp;amp; Govern.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lead / decisions:&lt;/b&gt; Council sponsors; domain owners provide evidence; appropriate reviewers challenge results.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; Evidence-based assessment rubric; domain capability profile; prioritized improvement plan; reassessment history." vertex="1">
                    <mxGeometry height="240" width="605" x="685" y="1616" as="geometry"/>
                </mxCell>
                <mxCell id="cap-footer" parent="1" style="text;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=15;fontColor=#475569;shadow=1;textShadow=1;" value="Start with decision rights, risk priorities, contracts and certification. Integrate with existing registers and workflows. See the guide for controls, limitations and verification. Page 1 preserves the supplied image model." vertex="1">
                    <mxGeometry height="48" width="1280" x="20" y="1910" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="trust-privacy-resilience" name="Trust, Privacy &amp; Resilience Guardrails">
        <mxGraphModel dx="1303" dy="937" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="1">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="guardrails-bg" parent="1" style="rounded=0;fillColor=#F8FAFC;strokeColor=none;" value="" vertex="1">
                    <mxGeometry height="900" width="1320" as="geometry"/>
                </mxCell>
                <mxCell id="guardrails-banner" parent="1" style="rounded=1;arcSize=16;fillColor=#0F172A;gradientColor=#2563EB;gradientDirection=east;strokeColor=none;shadow=1;" value="" vertex="1">
                    <mxGeometry height="120" width="1280" x="20" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="guardrails-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=32;fontStyle=1;fontColor=#FFFFFF;" value="Trust, Privacy &amp;amp; Resilience Guardrails" vertex="1">
                    <mxGeometry height="48" width="1230" x="45" y="37" as="geometry"/>
                </mxCell>
                <mxCell id="guardrails-subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#E0E7FF;" value="Additional recommendations | Apply proportionately to data criticality, purpose and risk" vertex="1">
                    <mxGeometry height="30" width="1230" x="45" y="88" as="geometry"/>
                </mxCell>
                <mxCell id="privacy-card" parent="1" style="rounded=1;arcSize=18;fillColor=#EFF6FF;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#60A5FA;strokeWidth=2;shadow=1;" value="" vertex="1">
                    <mxGeometry height="640" width="630" x="30" y="175" as="geometry"/>
                </mxCell>
                <mxCell id="privacy-badge" parent="1" style="rounded=1;arcSize=20;fillColor=#1E3A8A;gradientColor=#60A5FA;gradientDirection=east;strokeColor=none;shadow=1;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" value="C11" vertex="1">
                    <mxGeometry height="38" width="70" x="52" y="198" as="geometry"/>
                </mxCell>
                <mxCell id="privacy-heading" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#1E3A8A;" value="C11  |  PRIVACY, RIGHTS &amp; DATA LIFECYCLE" vertex="1">
                    <mxGeometry height="42" width="495" x="138" y="198" as="geometry"/>
                </mxCell>
                <mxCell id="privacy-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontFamily=Arial;fontSize=17;fontColor=#172033;" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Make purpose, privacy obligations and lifecycle decisions explicit from collection through disposal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Put into practice&lt;/b&gt;&lt;br&gt;• Record purpose, minimum necessary data and accountable owner.&lt;br&gt;• Define retention, archival, legal hold and deletion across sources, extracts, backups and derived assets.&lt;br&gt;• Route access, correction and deletion requests to accountable teams; record justified exceptions.&lt;br&gt;• Reassess purpose when data is reused; test end-to-end disposition and backup expiry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence&lt;/b&gt;&lt;br&gt;Purpose/use register · retention schedule · request workflow · disposition and exception records&lt;br&gt;&lt;br&gt;&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;Trace a test request across source, downstream and backup scopes; confirm completion evidence." vertex="1">
                    <mxGeometry height="535" width="574" x="58" y="255" as="geometry"/>
                </mxCell>
                <mxCell id="resilience-card" parent="1" style="rounded=1;arcSize=18;fillColor=#F5F3FF;gradientColor=#FFFFFF;gradientDirection=north;strokeColor=#A78BFA;strokeWidth=2;shadow=1;" value="" vertex="1">
                    <mxGeometry height="640" width="630" x="660" y="175" as="geometry"/>
                </mxCell>
                <mxCell id="resilience-badge" parent="1" style="rounded=1;arcSize=20;fillColor=#6D28D9;gradientColor=#A78BFA;gradientDirection=east;strokeColor=none;shadow=1;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" value="C12" vertex="1">
                    <mxGeometry height="38" width="70" x="682" y="198" as="geometry"/>
                </mxCell>
                <mxCell id="resilience-heading" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#6D28D9;" value="C12  |  RESILIENCE, RECOVERY &amp; PORTABILITY" vertex="1">
                    <mxGeometry height="42" width="495" x="768" y="198" as="geometry"/>
                </mxCell>
                <mxCell id="resilience-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontFamily=Arial;fontSize=17;fontColor=#172033;" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Keep critical data dependable through disruption and avoid unmanageable platform or provider dependency.&lt;br&gt;&lt;br&gt;&lt;b&gt;Put into practice&lt;/b&gt;&lt;br&gt;• Set business-approved recovery-time, recovery-point and availability objectives.&lt;br&gt;• Protect backups; exercise restoration and disaster recovery on a risk-based cadence.&lt;br&gt;• Validate recovered data for completeness, consistency and usability.&lt;br&gt;• Document dependencies, export formats, metadata and provider-exit steps for critical assets.&lt;br&gt;• Feed test failures and material supplier changes into the risk and funding backlog.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence&lt;/b&gt;&lt;br&gt;Critical data-service register · recovery objectives · restore results · portability and exit plan&lt;br&gt;&lt;br&gt;&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;Restore a representative critical asset in isolation and demonstrate objectives and usable export." vertex="1">
                    <mxGeometry height="535" width="574" x="688" y="255" as="geometry"/>
                </mxCell>
                <mxCell id="guardrails-footer" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#475569;" value="Decision rule: retain only the data and access needed, recover what matters and keep evidence that controls work." vertex="1">
                    <mxGeometry height="32" width="1230" x="45" y="840" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>