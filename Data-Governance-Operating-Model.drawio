                <mxCell id="cap-card-02" parent="1" style="rounded=1;arcSize=5;fillColor=#E7F4FD;strokeColor=#60A5FA;strokeWidth=1.5;shadow=1;textShadow=1;shadow=1;gradientColor=#FFFFFF;gradientDirection=north;" value="" vertex="1">
