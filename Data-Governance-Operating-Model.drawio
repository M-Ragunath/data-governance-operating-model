                </mxCell>
                <mxCell id="cap-heading-02" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=23;fontStyle=1;fontColor=#1E3A8A;shadow=1;textShadow=1;" value="Risk-based prioritization" vertex="1">
                    <mxGeometry height="42" width="542" x="748" y="205" as="geometry"/>
                </mxCell>
                <mxCell id="cap-body-02" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=17;fontColor=#1E3A8A;shadow=1;textShadow=1;" value="&lt;b&gt;Purpose:&lt;/b&gt; Apply effort and controls in proportion to business impact.&lt;br&gt;&lt;br&gt;&lt;b&gt;Applies to:&lt;/b&gt; All five stages.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lead / decisions:&lt;/b&gt; Data owner, with council oversight and specialist advice where required.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; Critical-data register; risk rubric; tier-to-control mapping; prioritized remediation backlog." vertex="1">
                    <mxGeometry height="240" width="605" x="685" y="256" as="geometry"/>
                </mxCell>
